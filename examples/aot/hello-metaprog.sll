;; hello-metaprog.sll -- the inverted format: the file IS sll data, and
;; Scheme is escaped INTO it. A .sll file is one big quasiquote body:
;; ,expr and ,@expr evaluate at compile time, and top-level
;; (scheme ...) forms hold the definitions (and imports!) they use.
;;
;; This is the portable syscall hello as a single self-contained .sll.
;; It adapts to the compiling host (x86-64 or ARM64 Linux) by picking
;; the kernel ABI at compile time, and it builds its inline asm with
;; (sll asm) -- registers as symbols, constraint strings computed.
;;
;;   sllc --render-llvm-ir examples/aot/hello-metaprog.sll  (see the result)
;;   sllc --opt O2 --exe   examples/aot/hello-metaprog.sll  (x86-64 Linux)

(scheme
  (import (prefix (sll asm) asm:))

  (define abi
    (case (machine-type)
      [(a6le ta6le) 'x86_64]
      [(arm64le tarm64le) 'aarch64]
      [else (error 'hello-metaprog "no syscall table for this host"
                   (machine-type))]))

  (define spec   ; (instruction nr-reg ret-reg arg-regs clobbers write exit)
    (case abi
      [(x86_64) '("syscall" rax rax (rdi rsi rdx) (rcx r11) 1 231)]
      [(aarch64) '("svc #0" x8 x0 (x0 x1 x2) () 64 94)]))

  (define sys-write (list-ref spec 5))
  (define sys-exit (list-ref spec 6))

  (define (syscall nr . args)   ; -> instruction forms for one syscall
    (let ([callee (apply asm:expr
                         `((out ret (reg ,(list-ref spec 2)))
                           (in nr (reg ,(list-ref spec 1)))
                           ,@(map (lambda (r i)
                                    `(in ,(string->symbol
                                            (string-append
                                              "a" (number->string i)))
                                         (reg ,r)))
                                  (list-head (list-ref spec 3)
                                             (length args))
                                  (iota (length args)))
                           (clobber ,@(list-ref spec 4) memory))
                         (list-ref spec 0)
                         '(sideeffect))])
      `((call i64 (,callee (i64 ,nr) ,@args))))))

(define void (@_start)
  (label %entry
    (= %buf (alloca (array 24 i8) (align 8)))
    (store (i64 5989836361474794824) (ptr %buf) (align 8))   ; "Hello, S"
    (= %p8 (getelementptr i8 (ptr %buf) (i64 8)))
    (store (i64 2399376699992402019) (ptr %p8) (align 8))    ; "chemeLL!"
    (= %p16 (getelementptr i8 (ptr %buf) (i64 16)))
    (store (i8 10) (ptr %p16))
    ,@(syscall sys-write '(i64 1) '(ptr %buf) '(i64 17))
    ,@(syscall sys-exit)
    (unreachable)))
