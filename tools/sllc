#!/bin/sh
# sllc -- the .sll compiler, self-locating and self-compiling.
# Chez compiles imported libraries to .so object files on first use
# (--compile-imported-libraries) and reuses them on every later run
# when they are newer than their sources; `make clean` removes them.
root="$(cd "$(dirname "$0")/.." && pwd)"
# `scheme` on most systems, Homebrew's `chez` on macOS, `chez-scheme` on
# FreeBSD; $CHEZ overrides. Same order as the Makefile and pre-commit hook.
if [ -z "$CHEZ" ]; then
  if command -v scheme >/dev/null 2>&1; then CHEZ=scheme
  elif command -v chez >/dev/null 2>&1; then CHEZ=chez
  else CHEZ=chez-scheme
  fi
fi
exec "$CHEZ" --compile-imported-libraries --libdirs "$root" \
     --script "$root/tools/sllc.ss" "$@"
