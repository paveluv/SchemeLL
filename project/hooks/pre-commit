#!/bin/sh
# pre-commit: format Scheme sources and Markdown samples with Schematter.
# Install once per clone:  git config core.hooksPath project/hooks

if [ ! -f schematter/schematter/hook.sls ]; then
    echo "pre-commit: Schematter is missing; run: git submodule update --init --recursive" >&2
    exit 1
fi

# Match the Makefile's Chez selection: scheme, Homebrew's chez, FreeBSD's
# chez-scheme, and $CHEZ overrides.
if [ -z "$CHEZ" ]; then
    if command -v scheme >/dev/null 2>&1; then CHEZ=scheme
    elif command -v chez >/dev/null 2>&1; then CHEZ=chez
    else CHEZ=chez-scheme
    fi
fi

exec "$CHEZ" --script project/hooks/pre-commit.sps
